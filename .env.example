MONGODB_URI=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (India) payment gateway.
# Without these the checkout shows a clear configuration message and never simulates a payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: GST percentage added to the taxable booking amount. Defaults to 0 (no tax invented).
BOOKING_TAX_PERCENT=0
# Minutes a seat is held while the customer completes checkout before auto-release.
BOOKING_HOLD_MINUTES=15

# Cloudinary and Resend credentials are added when media delivery and email are enabled.
